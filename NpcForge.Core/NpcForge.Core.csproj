<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NpcForge</RootNamespace>
    <!-- The compiler holds the core's boundary (ADR-014, decision 7). A call to anything in
         BannedSymbols.txt is an error, not a warning. CoreReferenceTests fails if a reference
         outside its allow-list appears in this file, or if RS0030 is suppressed in the core. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to 10.8.3, what the MCP server resolves today through ModelContextProtocol 2.2.0. A
         higher version here would reach the server through its project reference and lift the
         schema writer that builds roll_character's and lookup_archetype's schemas, which changes
         what the model is sent. It can move once the server is gone (ADR-014). -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The skills are content, not code. They travel with the core into every front end's bin
         folder, so the app reads them from next to the exe, and editing one changes the writing
         without touching any C# (ADR-014, decision 6). -->
    <None Include="skills\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
