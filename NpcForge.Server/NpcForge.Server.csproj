<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- Stays on 2.2.0 while the console is on 2.3.1 (epic 9). When a slow start makes a 2.3 client's
         discovery probe time out, the client falls back to initialize, and a 2.3 server refuses it
         once that session has settled on the newer protocol version; 2.2.0 accepts it. With both on
         2.3.1, 10 of 455 tests failed that way on a loaded machine. A 2.3 server would also reorder
         tools/list, which needs an ADR, and write its schema on a newer
         Microsoft.Extensions.AI.Abstractions than ADR-010 measured. The 5 s close was the client's
         to fix, so a server bump buys no speed. -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brief, the tables and the dice live in the core (ADR-014). This project is their MCP
         adapter until the console calls the core in-process. -->
    <ProjectReference Include="..\NpcForge.Core\NpcForge.Core.csproj" />
  </ItemGroup>

</Project>
